{
  "name": "dsh-mcp-toggles",
  "version": "1.1.0",
  "type": "module",
  "description": "MCP connector switches as a sidebar panel in DeepSeek Harness: the profile's mcp-* loader rows, a one-line intro per server, and a switch that edits only that row's disabled line.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "mcp",
    "settings",
    "toggle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echo-Li130/dsh-mcp-toggles.git"
  },
  "homepage": "https://github.com/Echo-Li130/dsh-mcp-toggles#readme",
  "bugs": {
    "url": "https://github.com/Echo-Li130/dsh-mcp-toggles/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "src",
    "client.js",
    "cordis.patch.yml",
    "public",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/patch.test.mjs test/http.test.mjs test/describe.test.mjs test/client.test.mjs",
    "validate": "node scripts/validate.mjs",
    "privacy-check": "node scripts/privacy-check.mjs",
    "prepack": "node scripts/validate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
